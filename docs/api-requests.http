###
# docs/api-requests.http — Requests de prueba para la MovieAPI
#
# Cómo usarlo (VS Code con la extensión "REST Client", o PhpStorm):
#   1. Arranca el servidor:  php artisan serve   →  http://localhost:8000
#   2. Abre este archivo y pulsa "Send Request" sobre cada bloque (###).
#
# Nota: las rutas de API llevan el prefijo /api/v1 (definido en
# bootstrap/app.php con apiPrefix: "api/v1").
###

# URL base del servidor local (php artisan serve)
@baseUrl = http://localhost:8000/api/v1
# Id del género sobre el que prueban show/update/delete/restore (cambien si quieren)
@genreId = 1
# Slug del género para probar la búsqueda por slug (cambien si quieren)
@slug = accion

### -----------------------------------------------------------
### Health check (comprueba que la API está viva)
### -----------------------------------------------------------
GET {{baseUrl}}/health
Accept: application/json

### -----------------------------------------------------------
### Listar todos los géneros  →  GET /api/v1/genres
### -----------------------------------------------------------
GET {{baseUrl}}/genres
Accept: application/json

### -----------------------------------------------------------
### Crear un género  →  POST /api/v1/genres
### El "slug" se genera solo a partir del "name".
### -----------------------------------------------------------
POST {{baseUrl}}/genres
Content-Type: application/json
Accept: application/json

{
  "name": "Suspenso",
  "description": "Películas con tensión y giros inesperados.",
  "is_active": true
}

### -----------------------------------------------------------
### Crear un género INVÁLIDO (para ver la validación en acción)
### Esperado: HTTP 422 con los errores de "name".
### -----------------------------------------------------------
POST {{baseUrl}}/genres
Content-Type: application/json
Accept: application/json

{
  "description": "Falta el name obligatorio.",
  "is_active": true
}

### -----------------------------------------------------------
### Ver un género por id  →  GET /api/v1/genres/{genre}
### -----------------------------------------------------------
GET {{baseUrl}}/genres/{{genreId}}
Accept: application/json

### -----------------------------------------------------------
### Actualizar un género  →  PUT /api/v1/genres/{genre}
### Al cambiar el "name", el "slug" se regenera automáticamente.
### -----------------------------------------------------------
PUT {{baseUrl}}/genres/{{genreId}}
Content-Type: application/json
Accept: application/json

{
  "name": "Suspenso Psicológico",
  "description": "Tensión mental y giros de trama.",
  "is_active": true
}

### -----------------------------------------------------------
### Borrar un género (soft delete)  →  DELETE /api/v1/genres/{genre}
### No borra de verdad: solo marca "deleted_at" en la BD.
### -----------------------------------------------------------
DELETE {{baseUrl}}/genres/{{genreId}}
Accept: application/json

### -----------------------------------------------------------
### Filtrar por texto  →  GET /api/v1/genres?search=...
### Busca coincidencias parciales en el "name" (sin distinguir mayúsculas).
### -----------------------------------------------------------
GET {{baseUrl}}/genres?search=acci
Accept: application/json

### -----------------------------------------------------------
### Filtrar por estado  →  GET /api/v1/genres?is_active=...
### Valores esperados: true | false
### -----------------------------------------------------------
GET {{baseUrl}}/genres?is_active=true
Accept: application/json

### -----------------------------------------------------------
### Filtrar combinando búsqueda y estado
### -----------------------------------------------------------
GET {{baseUrl}}/genres?search=acci&is_active=true
Accept: application/json

### -----------------------------------------------------------
### Ordenar  →  GET /api/v1/genres?sort_by=name&order=desc
### "sort_by" permite: name | created_at | is_active
### "order" permite: asc | desc
### (valores inválidos caen por defecto a name / asc)
### -----------------------------------------------------------
GET {{baseUrl}}/genres?sort_by=name&order=desc
Accept: application/json

### -----------------------------------------------------------
### Ver un género por slug  →  GET /api/v1/genres/slug/{slug}
### El slug se genera automáticamente desde el "name".
### -----------------------------------------------------------
GET {{baseUrl}}/genres/slug/{{slug}}
Accept: application/json

### -----------------------------------------------------------
### Restaurar un género borrado  →  POST /api/v1/genres/{id}/restore
### Requiere que el género esté borrado (soft delete) de antes.
### Ejecuta primero el DELETE de arriba y luego este bloque.
### -----------------------------------------------------------
POST {{baseUrl}}/genres/{{genreId}}/restore
Accept: application/json
